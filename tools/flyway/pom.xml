<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>top.aiolife.tools</groupId>
    <artifactId>database-migrations</artifactId>
    <version>1.0.0</version>
    <!-- 独立工具，不进入应用依赖或应用启动流程。 -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flyway.version>13.11.1</flyway.version>
        <migration.root>${project.basedir}/../..</migration.root>
        <adoption.version>20261028.06</adoption.version>
    </properties>
    <dependencies>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><version>${flyway.version}</version></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId><version>${flyway.version}</version></dependency>
        <dependency><groupId>org.mariadb.jdbc</groupId><artifactId>mariadb-java-client</artifactId><version>3.5.11</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.22.4</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><version>2.0.5</version><scope>test</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.17</version></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.17</version><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
        <plugin>
            <groupId>org.flywaydb</groupId><artifactId>flyway-maven-plugin</artifactId><version>${flyway.version}</version>
            <configuration>
                <locations><location>filesystem:${migration.root}/sql/migrations</location></locations>
                <driver>org.mariadb.jdbc.Driver</driver>
                <callbacks><callback>top.aiolife.migration.MigrationGuard</callback></callbacks>
                <cleanDisabled>true</cleanDisabled><baselineOnMigrate>false</baselineOnMigrate>
                <baselineVersion>${adoption.version}</baselineVersion><createSchemas>false</createSchemas>
                <outOfOrder>false</outOfOrder><validateMigrationNaming>true</validateMigrationNaming>
                <validateOnMigrate>true</validateOnMigrate><skipExecutingMigrations>false</skipExecutingMigrations>
                <placeholderReplacement>false</placeholderReplacement><failOnMissingLocations>true</failOnMissingLocations>
                <encoding>UTF-8</encoding>
            </configuration>
        </plugin>
        <plugin>
            <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
            <configuration>
                <mainClass>top.aiolife.migration.SchemaTool</mainClass>
                <systemProperties><systemProperty><key>migration.root</key><value>${migration.root}</value></systemProperty></systemProperties>
            </configuration>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
            <configuration><systemPropertyVariables><migration.root>${migration.root}</migration.root></systemPropertyVariables></configuration>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.4</version>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            <configuration><systemPropertyVariables>
                <migration.root>${migration.root}</migration.root><adoption.version>${adoption.version}</adoption.version>
                <schema.reportDirectory>${project.build.directory}/schema</schema.reportDirectory>
                <migration.mavenHome>${maven.home}</migration.mavenHome>
            </systemPropertyVariables></configuration>
        </plugin>
    </plugins></build>
</project>
